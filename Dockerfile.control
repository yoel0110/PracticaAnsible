
FROM ubuntu:24.04

ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update && \
    apt-get install -y \
    ansible \
    openssh-client \
    sshpass && \
    apt-get clean && \
    rm -rf /var/lib/apt/lists/*

WORKDIR /ansible

COPY ansible.cfg /ansible/ansible.cfg
COPY inventario.ini /ansible/inventario.ini

CMD ["sleep", "infinity"]
